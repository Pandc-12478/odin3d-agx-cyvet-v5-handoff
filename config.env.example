# 复制为 config.env，权限设为 600。由负责人填写 Bash 变量。
# 默认源码和构建产物都在一键包的 work/ 中。
# ODIN_MAP_ROOT="$HOME/odin3d_maps"
# ODIN_PACKAGE_CACHE="$ODIN3D_BASE/work/map-packages"
# ODIN_WIFI_IFACE=wlP1p1s0
# 留空时使用该网卡唯一的全局 IPv4；多个地址时填写其中一个。
ODIN_WIFI_IP=
ROS_DOMAIN_ID=90
ROS_LOCALHOST_ONLY=0

# 下列路径指向负责人提供的合法资源。配置文件中只填路径，不填密钥。
ODIN_ASSETS="$HOME/odin3d-private"
# ODIN_DRIVER_YAML="$ODIN_ASSETS/control_command.yaml"
# 仅在迁移旧机且两份 YAML 确实不同的情况下，另填 Launch 读取的配置。
# ODIN_DRIVER_LAUNCH_YAML="$ODIN_ASSETS/control_command.launch.yaml"
# ODIN_WEB_VENDOR="$ODIN_ASSETS/web/vendor"
# ODIN_CONVERTER="$ODIN_ASSETS/map_to_ply_arm64_v1.2.0"
# DOG_CONTROL_SOURCE="$ODIN_ASSETS/dog_control3.py"
# DOG_SDK_LIB_DIR="$HOME/uniubi_robot_sdk_py/.deps/uniubi_robot_sdk/lib/aarch64_host"
# DOG_IFACE=eno1
# DOG_DEVICE_ID=  # 仅在 AGX 私有 config.env 中填写，不提交或发送到聊天。
# 只有负责人核实目标设备已获厂商授权后，才将这两项设为 yes。
ODIN_VENDOR_AUTHORIZED=no
DOG_VENDOR_AUTHORIZED=no
# 校准并核对隔离副本的 bridge/publish_cyvet_body_tf.py 后由负责人填 yes。
ODIN_EXTRINSICS_CONFIRMED=no
# 旧机若要保留既有离线地图包，三项同时填入，必须和同一 BIN 对应。
# ODIN_LEGACY_BIN_SHA256=
# ODIN_LEGACY_PCD=
# ODIN_LEGACY_PACKAGE=

# 负责人确认相机连接、现场条件和可开始建图后改为 yes。
ODIN_WEB_CAMERA_CONFIRMED=no
# ODIN_WEB_PORT=8080
# ODIN_WEB_TLS_CERT="$ODIN_ASSETS/console.crt"
# ODIN_WEB_TLS_KEY="$ODIN_ASSETS/console.key"
# 仅限负责人确认隔离、可信的实验室网络时启用。共享网络应使用 TLS。
ODIN_WEB_TRUSTED_HTTP=no
